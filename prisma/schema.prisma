// Modelagem do banco. PostgreSQL + Prisma.
//
// Decisões principais (detalhadas no README):
// - O feed é montado na LEITURA (read-time fan-out): uma consulta junta as lojas
//   que o cliente segue com as novidades, ordenando por data. Como a loja publica
//   pouco e o cliente lê muito, o volume de novidades é pequeno e um índice resolve.
// - Índice (loja_id, criada_em DESC) em `novidades` sustenta o ORDER BY ... LIMIT
//   do feed sem varrer a tabela.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loja {
  id        String     @id @default(uuid()) @db.Uuid
  nome      String
  criadaEm  DateTime   @default(now()) @map("criada_em")
  novidades Novidade[]
  seguidores Seguidor[]

  @@map("lojas")
}

model Cliente {
  id       String     @id @default(uuid()) @db.Uuid
  nome     String
  email    String     @unique
  criadoEm DateTime   @default(now()) @map("criado_em")
  seguindo Seguidor[]

  @@map("clientes")
}

// Tabela de junção (quem segue quem). Chave primária composta evita seguir
// a mesma loja duas vezes no nível do banco (além da checagem na aplicação).
model Seguidor {
  clienteId String   @map("cliente_id") @db.Uuid
  lojaId    String   @map("loja_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  loja    Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@id([clienteId, lojaId])
  @@index([lojaId])
  @@map("seguidores")
}

model Novidade {
  id       String   @id @default(uuid()) @db.Uuid
  lojaId   String   @map("loja_id") @db.Uuid
  texto    String   @db.VarChar(500)
  preco    Decimal? @db.Decimal(12, 2)
  criadaEm DateTime @default(now()) @map("criada_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // Sustenta o feed: filtra por loja e já entrega ordenado por data desc.
  @@index([lojaId, criadaEm(sort: Desc)])
  @@map("novidades")
}
